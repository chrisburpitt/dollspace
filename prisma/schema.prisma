// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  MODERATOR
 }

model User {
  id                String     @id @default(cuid())
  username          String     @unique
  email             String     @unique 
  displayName       String
  passwordHash      String
  status            String     @default("ONLINE")

// Custom fields
  age               Int?
  genderIdentity    String?    
  location          String?
  lookingFor        String?
  bio               String?
  avatarUrl         String?
  bannerUrl         String?
  createdAt         DateTime   @default(now())
  views             Int        @default(0)

  posts             Post[]
  comments          Comment[]  
  reactions         Reaction[]
  albums            Album[]    @relation("UserAlbums")
  followers         Follow[]   @relation("UserFollowers")
  following         Follow[]   @relation("UserFollowing")

  mailsSent             InternalMail[] @relation("MailsAsSender")
  mailsReceived         InternalMail[] @relation("MailsAsRecipient")
  messagesReceived      DirectMessage[] @relation("MessageRecipient")
  messagesSent          DirectMessage[] @relation("MessageSender")
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationTrigger")
  
  latitude          Float?
  longitude         Float?
  lastActive        DateTime       @default(now())
  
  role              Role           @default(USER)
  isBanned          Boolean        @default(false)
  banReason         String?
  bannedAt          DateTime?
}

model Post {
  id        String     @id @default(cuid())
  content   String
  createdAt DateTime   @default(now())
  imageUrl  String?
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  reactions Reaction[]
  comments  Comment[]  

  images    PostImage[] @relation("PostImages")

  linkUrl        String?
  linkTitle      String?
  linkDesc       String?
  linkImage      String?

  @@index([userId])
}

model PostImage {
  id        String   @id @default(cuid())
  url       String
  createdAt DateTime @default(now())
  
  postId    String
  post      Post     @relation("PostImages", fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Reaction {
  id        String   @id @default(cuid())
  emoji     String   
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji]) 
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
}

model DirectMessage {
  id          String   @id @default(cuid())
  content     String
  createdAt   DateTime @default(now())
  isRead      Boolean  @default(false)

  // Account sending the message text string
  senderId    String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  // Account receiving the private message
  recipientId String
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  // Unique composite string token used to pool private room channels (e.g. "userA-userB")
  roomToken   String

  @@index([roomToken])
}

model InternalMail {
  id             String            @id @default(cuid())
  subject        String
  body           String            // Stores rich text markdown or HTML strings safely
  createdAt      DateTime          @default(now())
  isRead         Boolean           @default(false)

  // Sender Identity & Folder State Controls
  senderId       String
  sender         User              @relation("MailsAsSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderArchived Boolean           @default(false)
  senderDeleted  Boolean           @default(false)

  // Recipient Identity & Folder State Controls
  recipientId    String
  recipient      User              @relation("MailsAsRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientArchived Boolean         @default(false)
  recipientDeleted  Boolean         @default(false)

  // 🚀 ATTACHMENT MULTI-IMAGE CHILD CONNECTIONS
  attachments    MailAttachment[] @relation("MailAttachments")

  @@index([senderId])
  @@index([recipientId])
}

model MailAttachment {
  id         String       @id @default(cuid())
  url        String
  createdAt  DateTime     @default(now())
  
  mailId     String
  mail       InternalMail @relation("MailAttachments", fields: [mailId], references: [id], onDelete: Cascade)

  @@index([mailId])
}

model Album {
  id          String   @id @default(cuid())
  name        String
  description String?
  isPrivate   Boolean  @default(false) // 🔒 false = PUBLIC (default), true = PRIVATE
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation("UserAlbums", fields: [userId], references: [id], onDelete: Cascade)
  photos      Photo[]  @relation("AlbumPhotos")
}

model Photo {
  id        String   @id @default(cuid())
  url       String
  createdAt DateTime @default(now())
  albumId   String
  album     Album    @relation("AlbumPhotos", fields: [albumId], references: [id], onDelete: Cascade)
}

model Follow {
  followerId  String
  followingId String

  follower    User   @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])  // 🚀 INDEX: Fast-tracks follower count Lookups
  @@index([followingId]) // 🚀 INDEX: Fast-tracks following count Lookups
}

model Notification {
  id          String   @id @default(cuid())
  type        String   // FOLLOW, LIKE, COMMENT
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  // The account receiving the notification banner alert
  recipientId String
  recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  
  // The account that caused the action (e.g. who clicked follow)
  issuerId    String
  issuer      User     @relation("NotificationTrigger", fields: [issuerId], references: [id], onDelete: Cascade)
  
  // Optional pointer fields depending on the event context
  postId      String?

  @@index([recipientId])
  @@index([issuerId])
}
